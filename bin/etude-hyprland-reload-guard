#!/bin/bash
# Hyprland-Neuladen während eines Etude-Updates anhalten (pacman-Hooks, nicht von Hand aufrufen).
#
#   etude-hyprland-reload-guard pause    vor dem Update:  Auto-Reload aus, Fehlermeldungen aus
#   etude-hyprland-reload-guard resume   nach dem Update: einmal sauber neu laden, alte Werte zurück,
#                                        etude-setup in der Sitzung (Links, Migrationen)
#   etude-hyprland-reload-guard paused   Rückgabe 0, solange ein Update läuft
#
# Warum: pacman ersetzt die Dateien unter /usr/share/etude nacheinander. Hyprland lädt bei jeder
# Änderung neu und sieht dabei einen halben Stand – die Config ist „kaputt“, bis Hyprland neu startet.
# Nach Omarchy (MIT, © David Heinemeier Hansson): bin/omarchy-hyprland-reload-guard
set -euo pipefail

command="${1:-}"
case "$command" in
    pause | resume | paused) ;;
    *) echo "Usage: etude-hyprland-reload-guard pause|resume|paused" >&2; exit 1 ;;
esac

run_root="${ETUDE_RELOAD_GUARD_RUN_ROOT:-/run/user}"
state_dir="${ETUDE_RELOAD_GUARD_STATE_DIR:-/run/etude/hyprland-reload-guard}"
hyprctl_bin="${HYPRCTL:-/usr/bin/hyprctl}"
proc_root="${ETUDE_RELOAD_GUARD_PROC_ROOT:-/proc}"

[ -x "$hyprctl_bin" ] || exit 0

hyprctl_instance() {
    local runtime_dir="$1" signature="$2"
    shift 2
    XDG_RUNTIME_DIR="$runtime_dir" "$hyprctl_bin" --instance "$signature" "$@"
}

option_bool() {
    # tote Instanz: hyprctl schreibt „Couldn't connect …“ auf stdout → jq schlägt fehl, Instanz übersprungen
    hyprctl_instance "$1" "$2" -j getoption "$3" 2>/dev/null | jq -r '.bool' 2>/dev/null
}

instances() {
    local instance_dir signature hypr_dir runtime_dir uid
    [[ -d $run_root ]] || return 0
    for instance_dir in "$run_root"/*/hypr/*; do
        [[ -d $instance_dir ]] || continue
        signature="${instance_dir##*/}"
        hypr_dir="${instance_dir%/*}"
        runtime_dir="${hypr_dir%/*}"
        uid="${runtime_dir##*/}"
        [[ $uid =~ ^[0-9]+$ ]] || continue
        printf '%s\t%s\n' "$runtime_dir" "$signature"
    done
}

pause_instance() {
    local runtime_dir="$1" signature="$2" disable_autoreload suppress_errors state_file="$state_dir/$2"
    mkdir -p "$state_dir"
    if [[ ! -f $state_file ]]; then
        disable_autoreload=$(option_bool "$runtime_dir" "$signature" misc.disable_autoreload) || return 0
        suppress_errors=$(option_bool "$runtime_dir" "$signature" debug.suppress_errors) || return 0
        printf '%s\t%s\t%s\n' "$runtime_dir" "$disable_autoreload" "$suppress_errors" > "$state_file"
    fi
    hyprctl_instance "$runtime_dir" "$signature" eval \
        'hl.config({ misc = { disable_autoreload = true }, debug = { suppress_errors = true } })' \
        >/dev/null 2>&1 || true
}

# Hat das Update Hyprland selbst ersetzt, läuft noch das alte Programm (Kernel: „(deleted)“) –
# das kennt neue Config-Werte nicht. Dann bis zum nächsten Anmelden nichts mehr neu laden.
running_replaced_binary() {
    local runtime_dir="$1" signature="$2" pid
    pid=$(XDG_RUNTIME_DIR="$runtime_dir" "$hyprctl_bin" -j instances 2>/dev/null |
        jq -r --arg signature "$signature" '.[] | select(.instance == $signature) | .pid' 2>/dev/null) || return 1
    [[ -n $pid && $(readlink "$proc_root/$pid/exe" 2>/dev/null) == *" (deleted)" ]]
}

resume_instance() {
    local state_file="$1" signature="${1##*/}" runtime_dir disable_autoreload suppress_errors
    IFS=$'\t' read -r runtime_dir disable_autoreload suppress_errors < "$state_file" || return 0
    if [[ -d $runtime_dir ]] && ! running_replaced_binary "$runtime_dir" "$signature"; then
        hyprctl_instance "$runtime_dir" "$signature" eval \
            "hl.config({ debug = { suppress_errors = $suppress_errors } })" >/dev/null 2>&1 || true
        # neue Links/Migrationen zuerst (etude-setup läuft in der Sitzung als der Nutzer), dann neu laden
        hyprctl_instance "$runtime_dir" "$signature" eval 'hl.exec_cmd("etude-setup")' >/dev/null 2>&1 || true
        sleep 1
        hyprctl_instance "$runtime_dir" "$signature" reload >/dev/null 2>&1 || true
        hyprctl_instance "$runtime_dir" "$signature" eval \
            "hl.config({ misc = { disable_autoreload = $disable_autoreload }, debug = { suppress_errors = $suppress_errors } })" \
            >/dev/null 2>&1 || true
    fi
    rm -f "$state_file"
}

case "$command" in
    paused)
        compgen -G "$state_dir/*" >/dev/null
        ;;
    pause)
        while IFS=$'\t' read -r runtime_dir signature; do
            pause_instance "$runtime_dir" "$signature"
        done < <(instances)
        ;;
    resume)
        [[ -d $state_dir ]] || exit 0
        for state_file in "$state_dir"/*; do
            [[ -f $state_file ]] || continue
            resume_instance "$state_file"
        done
        rmdir "$state_dir" 2>/dev/null || true
        ;;
esac
