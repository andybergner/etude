#!/bin/sh
# Öffnet den Etude-Task-Manager (App-ID: com.etude.taskmanager), optional auf einer Seite:
#   etude-taskmanager               -> Prozesse
#   etude-taskmanager performance   -> Leistung   (processes, performance, startup, details, services)
# Läuft er schon, wird nur das Fenster nach vorne geholt (und ggf. die Seite gewechselt).
APP_ID="com.etude.taskmanager"
# Wo Etude liegt: ETUDE_HOME, sonst das Repo (Entwicklung), sonst das Paket
SELF_DIR=$(dirname "$(readlink -f "$0")")
if [ -z "${ETUDE_HOME:-}" ]; then
    if [ -f "$SELF_DIR/../shell/shell.qml" ]; then ETUDE_HOME=$(cd "$SELF_DIR/.." && pwd); else ETUDE_HOME=/usr/share/etude; fi
fi
export ETUDE_HOME
# Repo-Module vor den installierten (nur in der Entwicklung gibt es $ETUDE_HOME/qml)
[ -d "$ETUDE_HOME/qml" ] && export QML_IMPORT_PATH="$ETUDE_HOME/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
APP="$ETUDE_HOME/apps/taskmanager"
PAGE="${1:-}"


app_pid() {
    for p in $(pgrep -x qs); do
        tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qx "ETUDE_APP_ID=$1" && { echo "$p"; return 0; }
    done
    return 1
}

if pid="$(app_pid "$APP_ID")"; then
    [ -n "$PAGE" ] && qs -p "$APP" ipc call taskmanager open "$PAGE" >/dev/null 2>&1
    hyprctl dispatch "hl.dsp.focus({ window = \"pid:$pid\" })" >/dev/null 2>&1
    exit 0
fi

QS_APP_ID="$APP_ID" ETUDE_APP_ID="$APP_ID" ETUDE_TASKMANAGER_PAGE="${PAGE:-processes}" setsid -f qs -p "$APP" >/dev/null 2>&1
