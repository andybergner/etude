#!/bin/sh
# Richtet Etude für den angemeldeten Nutzer ein. Läuft bei jedem Anmelden (etude-session),
# ist idempotent und überschreibt nie etwas, das der Nutzer selbst angelegt hat.
#
#   1. Hyprland: ~/.config/hypr/etude -> $ETUDE_HOME/default/hypr (Etude-Defaults),
#                eigene hyprland.lua aus config/hypr (falls keine da ist)
#   2. kitty:    ~/.config/kitty/etude.conf -> $ETUDE_HOME/default/kitty/kitty.conf,
#                eigene kitty.conf aus config/kitty (falls keine da ist)
#   3. Einstellungen: etude-config migrate (Bereiche anlegen, alte settings.json verteilen)
#   4. Migrationen: $ETUDE_HOME/migrations/NNN-name.sh, jede genau einmal
#
# Im Entwicklungsmodus (~/.config/etude/dev-home) übernimmt etude-dev-link Schritt 1 und 2.
set -eu

SELF_DIR=$(dirname "$(readlink -f "$0")")
if [ -z "${ETUDE_HOME:-}" ]; then
    if [ -f "$SELF_DIR/../shell/shell.qml" ]; then ETUDE_HOME=$(cd "$SELF_DIR/.." && pwd); else ETUDE_HOME=/usr/share/etude; fi
fi
export ETUDE_HOME

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/etude"
mkdir -p "$CFG/etude" "$STATE"
log() { echo "etude-setup: $*" >&2; }

# Link setzen, aber nur, wenn dort nichts Eigenes liegt
link() {
    if [ -L "$2" ]; then
        [ "$(readlink "$2")" = "$1" ] && return 0
        ln -sfn "$1" "$2"; log "link $2 -> $1"
    elif [ ! -e "$2" ]; then
        mkdir -p "$(dirname "$2")"; ln -s "$1" "$2"; log "link $2 -> $1"
    else
        log "keeping your own $2"
    fi
}
# Vorlage kopieren, wenn es die Datei noch nicht gibt
seed() {
    [ -e "$2" ] && return 0
    mkdir -p "$(dirname "$2")"; cp "$1" "$2"; chmod 644 "$2"; log "created $2"
}

if [ ! -f "$CFG/etude/dev-home" ]; then
    link "$ETUDE_HOME/default/hypr" "$CFG/hypr/etude"
    seed "$ETUDE_HOME/config/hypr/hyprland.lua" "$CFG/hypr/hyprland.lua"
    link "$ETUDE_HOME/default/kitty/kitty.conf" "$CFG/kitty/etude.conf"
    seed "$ETUDE_HOME/config/kitty/kitty.conf" "$CFG/kitty/kitty.conf"
fi

# Einstellungen
if command -v etude-config >/dev/null 2>&1; then etude-config migrate
elif [ -x "$ETUDE_HOME/bin/etude-config" ]; then "$ETUDE_HOME/bin/etude-config" migrate
fi

# Migrationen: Nummer im Dateinamen, Stand in ~/.local/state/etude/migration
done_n=$(cat "$STATE/migration" 2>/dev/null || echo 0)
for m in "$ETUDE_HOME"/migrations/[0-9]*.sh; do
    [ -f "$m" ] || continue
    n=$(basename "$m" | sed 's/^0*\([0-9][0-9]*\).*/\1/')
    [ "$n" -gt "$done_n" ] || continue
    log "migration $(basename "$m")"
    if sh "$m"; then
        done_n=$n; echo "$done_n" > "$STATE/migration"
    else
        log "migration $(basename "$m") failed – will retry next login"; break
    fi
done
exit 0
