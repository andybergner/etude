// Etude: Mitglieder von "wheel" dürfen ohne Passwortabfrage
//  - neu starten, ausschalten, Ruhezustand (Startmenü)
//  - Gerätename, Zeitzone/NTP, Systemsprache und Tastatur ändern (Einstellungen)
//  - Netzwerk: IP/DNS ändern, Adapter und WLAN ein-/ausschalten (Einstellungen)
//  - Konto: eigenen Namen, eigenes Profilbild und eigenes Kennwort ändern
//    (das alte Kennwort prüft die Einstellungen-App vorher selbst per PAM)
//  - Speicher: alte Pakete aus dem Cache und alte Protokolle löschen (nur diese zwei Befehle)
//  - Firewall: Status von ufw lesen (nur lesen – Ändern fragt die Benutzerkontensteuerung)
//  - Anmeldebildschirm: das eigene Aussehen und die Bildschirme übernehmen (etude-greeter appearance/display, macht die Shell automatisch)
//  - Anmeldebildschirm (Benutzer „greeter“): Netzwerk-Menü – WLAN verbinden/trennen, WLAN ein/aus.
//    Neue WLANs werden dabei systemweit gespeichert, damit sie auch vor der Anmeldung verbinden.
// Installation (Entwicklung): sudo install -Dm644 default/polkit/rules.d/50-etude.rules /etc/polkit-1/rules.d/
// Als Paket landet sie in /usr/share/polkit-1/rules.d/
polkit.addRule(function (action, subject) {
    // Anmeldebildschirm: nur Netzwerk, nur am Gerät in der aktiven Sitzung
    if (subject.user == "greeter" && subject.local && subject.active) {
        var greeterNet = [
            "org.freedesktop.NetworkManager.network-control",
            "org.freedesktop.NetworkManager.settings.modify.system",
            "org.freedesktop.NetworkManager.enable-disable-wifi",
            "org.freedesktop.NetworkManager.wifi.scan"
        ];
        if (greeterNet.indexOf(action.id) >= 0) return polkit.Result.YES;
    }

    var allowed = [
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.freedesktop.login1.suspend-multiple-sessions",
        "org.freedesktop.hostname1.set-hostname",
        "org.freedesktop.hostname1.set-static-hostname",
        "org.freedesktop.hostname1.set-machine-info",
        "org.freedesktop.timedate1.set-timezone",
        "org.freedesktop.timedate1.set-ntp",
        "org.freedesktop.timedate1.set-time",
        "org.freedesktop.locale1.set-locale",
        "org.freedesktop.locale1.set-keyboard",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.share.protected",
        "org.freedesktop.NetworkManager.wifi.share.open",
        "org.freedesktop.accounts.change-own-user-data",
        "org.freedesktop.accounts.change-own-password"
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }

    // Speicher aufräumen (Einstellungen › System › Speicher): nur genau diese Befehle per pkexec
    if (action.id == "org.freedesktop.policykit.exec" && subject.isInGroup("wheel")) {
        var cmd = action.lookup("command_line");
        if (cmd == "/usr/bin/paccache -rk1" || cmd == "/usr/bin/journalctl --vacuum-size=100M" ||
            cmd == "/usr/bin/ufw status verbose" || cmd == "/usr/bin/ufw status numbered") {
            return polkit.Result.YES;
        }
        // Anmeldebildschirm übernimmt das Aussehen (etude-greeter liest das Bild als der aufrufende Nutzer)
        if (action.lookup("program") == "/usr/bin/etude-greeter" && subject.local && subject.active &&
            cmd.indexOf("/usr/bin/etude-greeter appearance ") == 0) {
            return polkit.Result.YES;
        }
        // … und die Bildschirme (Auflösung, Skalierung) – etude-greeter prüft jeden Wert
        if (action.lookup("program") == "/usr/bin/etude-greeter" && subject.local && subject.active &&
            cmd.indexOf("/usr/bin/etude-greeter display ") == 0) {
            return polkit.Result.YES;
        }
    }
});
