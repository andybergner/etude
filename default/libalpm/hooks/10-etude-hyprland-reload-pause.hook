# Nach Omarchy (MIT): default/libalpm/hooks/*-omarchy-hyprland-reload-*.hook
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = etude
Target = etude-ui

[Action]
Description = Hyprland-Neuladen für das Etude-Update anhalten …
When = PreTransaction
Exec = /usr/bin/etude-hyprland-reload-guard pause
